[{"name":"app.R","content":"#\r\n# This is a Shiny web application. You can run the application by clicking\r\n# the 'Run App' button above.\r\n#\r\n# Find out more about building applications with Shiny here:\r\n#\r\n#    https://shiny.posit.co/\r\n#\r\n\r\nlibrary(shiny)\r\n\r\n# Define UI for application that draws a histogram\r\nui <- fluidPage(\r\n  \r\n  # set theme\r\n  theme = bslib::bs_theme(bootswatch = \"journal\"),\r\n  \r\n  # create different panels\r\n  tabsetPanel(\r\n    \r\n    # first panel\r\n    tabPanel(\"Overview\",\r\n\r\n    # Application title\r\n    titlePanel(\"AI-DG - Avoid Inefficient Data Generation\"),\r\n    \r\n    p(\"\"),\r\n    \r\n    h1(\"What is AI-DG?\"),\r\n  \r\n    p(em(\"AI-DG aims to bring together scholars who are collecting or planning to collect social science text data.\")),\r\n    \r\n    h1(\"Why?\"),\r\n    \r\n    p(em(\"Many datasets are currently developed in isolation, often simultaneously, leading to duplicated efforts and missed opportunities for collaboration. Early coordination can help researchers identify synergies, share resources, exchange knowledge about existing sources, identify gaps, and develop common metadata standards.\")),\r\n    \r\n    h1(\"What do we provide?\"),\r\n    \r\n    p(em(\"--> A large network of scholars, supported by an AI-powered search tool that helps researchers connect with others working on similar data collection projects.\")),\r\n    \r\n    p(em(\"--> An overview of datasets currently under development.\")),\r\n          \r\n    p(em(\"--> Regular updates on promising data projects and newly released datasets.\")),\r\n    \r\n    h1(\"How can I join AI-DG?\"),\r\n    \r\n    p(em(\"As we continue presenting AI-DG to the broader research community, you are welcome to join as an official collaborator to join the network.\r\n  \r\n          If you are willing to be included, please reach out to either Leonce () or Simon.\")),\r\n    \r\n    p(em(\"Below you can see a list of collaborators that have already joined our initiative!\"))),\r\n  \r\n  tabPanel(\"Data Portal\",\r\n           \r\n           h1(\"Data Overview\"),\r\n  \r\n           tags$iframe(\r\n             src = \"corpus_coverage_explorer.html\",\r\n             width = \"100%\",\r\n             height = \"800px\",\r\n             style = \"border: none;\"\r\n           )\r\n    )\r\n  )\r\n)\r\n\r\n# Define server logic required to draw a histogram\r\nserver <- function(input, output) {\r\n\r\n    \r\n}\r\n\r\n# Run the application \r\nshinyApp(ui = ui, server = server)\r\n","type":"text"},{"name":"corpus_coverage_explorer_alt.html","content":"\n<style>\n* { box-sizing: border-box; margin: 0; padding: 0; }\nbody { font-family: var(--font-sans); }\n.wrap { padding: 1rem 0; }\n.summary-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-bottom: 1.25rem; }\n.metric { background: var(--color-background-secondary); border-radius: var(--border-radius-md); padding: .75rem 1rem; }\n.metric-label { font-size: 12px; color: var(--color-text-secondary); margin-bottom: 4px; }\n.metric-value { font-size: 20px; font-weight: 500; color: var(--color-text-primary); }\n.controls { display: flex; gap: 10px; margin-bottom: 1rem; }\n.controls input { flex: 1; }\n.controls select { min-width: 140px; }\n.tbl-wrap { overflow-x: auto; border: 0.5px solid var(--color-border-tertiary); border-radius: var(--border-radius-lg); }\ntable { width: 100%; border-collapse: collapse; font-size: 13px; table-layout: fixed; }\nth { padding: 8px 12px; text-align: left; font-weight: 500; font-size: 12px; color: var(--color-text-secondary); background: var(--color-background-secondary); cursor: pointer; user-select: none; border-bottom: 0.5px solid var(--color-border-tertiary); white-space: nowrap; }\nth:hover { color: var(--color-text-primary); }\nth .sort-icon { margin-left: 4px; opacity: .4; font-size: 11px; }\nth.active .sort-icon { opacity: 1; }\ntd { padding: 7px 12px; border-bottom: 0.5px solid var(--color-border-tertiary); color: var(--color-text-primary); vertical-align: middle; }\ntr:last-child td { border-bottom: none; }\ntr:hover td { background: var(--color-background-secondary); }\ncol.c1 { width: 18%; }\ncol.c2 { width: 14%; }\ncol.c3 { width: 12%; }\ncol.c4 { width: 12%; }\ncol.c5 { width: 44%; }\n.docs { font-variant-numeric: tabular-nums; text-align: right; }\n.bar-cell { padding: 7px 12px; }\n.bar-bg { background: var(--color-background-secondary); border-radius: 3px; height: 8px; position: relative; overflow: hidden; }\n.bar-fill { height: 100%; border-radius: 3px; background: #185FA5; position: absolute; left: 0; top: 0; }\n.year-label { font-size: 11px; color: var(--color-text-secondary); margin-top: 3px; }\n.badge { display: inline-block; font-size: 11px; padding: 2px 7px; border-radius: var(--border-radius-md); background: var(--color-background-info); color: var(--color-text-info); }\n.footer { font-size: 12px; color: var(--color-text-secondary); margin-top: .75rem; }\n.no-results { text-align: center; padding: 2rem; color: var(--color-text-secondary); font-size: 14px; }\n<\/style>\n\n<div class=\"wrap\">\n  <h2 class=\"sr-only\" style=\"position:absolute;left:-9999px\">Corpus coverage explorer — 32 countries, 78.5M documents, 1919–2025<\/h2>\n\n  <div class=\"summary-row\" id=\"summaryRow\"><\/div>\n\n  <div class=\"controls\">\n    <input type=\"text\" id=\"searchBox\" placeholder=\"Search country…\" oninput=\"render()\" />\n    <select id=\"sortCol\" onchange=\"render()\">\n      <option value=\"country\">Sort: country A–Z<\/option>\n      <option value=\"docs_desc\">Sort: most documents<\/option>\n      <option value=\"docs_asc\">Sort: fewest documents<\/option>\n      <option value=\"start_asc\">Sort: earliest start<\/option>\n      <option value=\"end_desc\">Sort: most recent end<\/option>\n    <\/select>\n  <\/div>\n\n  <div class=\"tbl-wrap\">\n    <table>\n      <colgroup>\n        <col class=\"c1\"><col class=\"c2\"><col class=\"c3\"><col class=\"c4\"><col class=\"c5\">\n      <\/colgroup>\n      <thead>\n        <tr>\n          <th onclick=\"setSort('country')\" id=\"th-country\">Country <span class=\"sort-icon\">↕<\/span><\/th>\n          <th onclick=\"setSort('docs_desc')\" id=\"th-docs\" style=\"text-align:right\">Documents <span class=\"sort-icon\">↕<\/span><\/th>\n          <th onclick=\"setSort('start_asc')\" id=\"th-start\">Start <span class=\"sort-icon\">↕<\/span><\/th>\n          <th onclick=\"setSort('end_desc')\" id=\"th-end\">End <span class=\"sort-icon\">↕<\/span><\/th>\n          <th>Coverage period<\/th>\n        <\/tr>\n      <\/thead>\n      <tbody id=\"tbody\"><\/tbody>\n    <\/table>\n  <\/div>\n  <div class=\"footer\" id=\"footerLine\"><\/div>\n<\/div>\n\n<script>\nconst RAW = [\n  [\"Austria\",2022212,1996,2022],\n  [\"Belgium\",670412,2009,2022],\n  [\"Bosnia and Herzegovina\",126252,1998,2022],\n  [\"Bulgaria\",210018,2014,2022],\n  [\"Croatia\",734415,2003,2022],\n  [\"Czech Republic\",689692,1993,2023],\n  [\"Denmark\",1771779,1997,2021],\n  [\"Estonia\",227872,2011,2022],\n  [\"European Union\",574119,1999,2024],\n  [\"Finland\",146858,2015,2022],\n  [\"France\",5387336,2009,2022],\n  [\"Germany\",3271713,1991,2021],\n  [\"Ghana\",352280,2005,2024],\n  [\"Great Britain\",9177947,1988,2022],\n  [\"Greece\",1623192,1989,2022],\n  [\"Hungary\",2278295,1994,2022],\n  [\"Iceland\",95286,2015,2022],\n  [\"Ireland\",21517564,1919,2019],\n  [\"Italy\",2627514,1948,2022],\n  [\"Latvia\",660012,1993,2022],\n  [\"Netherlands\",1752614,1994,2022],\n  [\"New Zealand\",925766,1987,2019],\n  [\"Norway\",398809,1998,2022],\n  [\"Poland\",14874946,1919,2025],\n  [\"Portugal\",1472804,2009,2022],\n  [\"Serbia\",316069,1997,2022],\n  [\"Slovenia\",311354,2000,2022],\n  [\"South Africa\",309716,1999,2024],\n  [\"Spain\",638060,1996,2023],\n  [\"Spain (Basque)\",39148,2015,2022],\n  [\"Spain (Catalonia)\",50824,2015,2022],\n  [\"Spain (Galicia)\",83078,2015,2022],\n  [\"Sweden\",450222,1990,2022],\n  [\"Turkey\",681052,2011,2022],\n  [\"Ukraine\",429437,2002,2023],\n];\n\nconst MIN_YEAR = 1919, MAX_YEAR = 2025;\nlet sortKey = 'country';\n\nfunction setSort(k) {\n  sortKey = k;\n  document.querySelectorAll('th').forEach(t => t.classList.remove('active'));\n  const map = {country:'th-country',docs_desc:'th-docs',docs_asc:'th-docs',start_asc:'th-start',end_desc:'th-end'};\n  if (map[k]) document.getElementById(map[k])?.classList.add('active');\n  render();\n}\n\nfunction fmt(n) { return n.toLocaleString('en-GB'); }\n\nfunction render() {\n  const q = document.getElementById('searchBox').value.toLowerCase();\n  const sortSel = document.getElementById('sortCol').value;\n  const key = sortSel || sortKey;\n\n  let rows = RAW.filter(r => r[0].toLowerCase().includes(q));\n\n  rows.sort((a,b) => {\n    if (key==='country') return a[0].localeCompare(b[0]);\n    if (key==='docs_desc') return b[1]-a[1];\n    if (key==='docs_asc') return a[1]-b[1];\n    if (key==='start_asc') return a[2]-b[2];\n    if (key==='end_desc') return b[3]-a[3];\n    return 0;\n  });\n\n  const tbody = document.getElementById('tbody');\n  if (rows.length === 0) {\n    tbody.innerHTML = `<tr><td colspan=\"5\" class=\"no-results\">No countries match your search.<\/td><\/tr>`;\n  } else {\n    tbody.innerHTML = rows.map(r => {\n      const [country, docs, start, end] = r;\n      const span = MAX_YEAR - MIN_YEAR;\n      const leftPct = Math.round(((start - MIN_YEAR) / span) * 100);\n      const widthPct = Math.max(2, Math.round(((end - start) / span) * 100));\n      return `<tr>\n        <td>${country}<\/td>\n        <td class=\"docs\">${fmt(docs)}<\/td>\n        <td>${start}<\/td>\n        <td>${end}<\/td>\n        <td class=\"bar-cell\">\n          <div class=\"bar-bg\" title=\"${start}–${end}\">\n            <div class=\"bar-fill\" style=\"left:${leftPct}%;width:${widthPct}%\"><\/div>\n          <\/div>\n          <div class=\"year-label\">${MIN_YEAR} ← ${start}–${end} → ${MAX_YEAR}<\/div>\n        <\/td>\n      <\/tr>`;\n    }).join('');\n  }\n\n  const totalDocs = rows.reduce((s,r)=>s+r[1],0);\n  const avgSpan = rows.length ? Math.round(rows.reduce((s,r)=>s+(r[3]-r[2]),0)/rows.length) : 0;\n  document.getElementById('summaryRow').innerHTML = `\n    <div class=\"metric\"><div class=\"metric-label\">Countries shown<\/div><div class=\"metric-value\">${rows.length}<\/div><\/div>\n    <div class=\"metric\"><div class=\"metric-label\">Documents (filtered)<\/div><div class=\"metric-value\">${fmt(totalDocs)}<\/div><\/div>\n    <div class=\"metric\"><div class=\"metric-label\">Avg. coverage span<\/div><div class=\"metric-value\">${avgSpan} yrs<\/div><\/div>\n  `;\n  document.getElementById('footerLine').textContent = `Showing ${rows.length} of ${RAW.length} countries · ${fmt(totalDocs)} documents`;\n}\n\nrender();\n<\/script>\n","type":"text"},{"name":"www/corpus_coverage_explorer.html","content":"\n<style>\n* { box-sizing: border-box; margin: 0; padding: 0; }\n.wrap { padding: 1rem 0; }\n.summary-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-bottom: 1.25rem; }\n.metric { background: var(--color-background-secondary); border-radius: var(--border-radius-md); padding: .75rem 1rem; }\n.metric-label { font-size: 12px; color: var(--color-text-secondary); margin-bottom: 4px; }\n.metric-value { font-size: 20px; font-weight: 500; color: var(--color-text-primary); }\n.controls { display: flex; gap: 10px; margin-bottom: 1rem; flex-wrap: wrap; }\n.controls input { flex: 1; min-width: 140px; }\n.controls select { min-width: 160px; }\n.tbl-wrap { overflow-x: auto; border: 0.5px solid var(--color-border-tertiary); border-radius: var(--border-radius-lg); }\ntable { width: 100%; border-collapse: collapse; font-size: 12px; }\nth { padding: 8px 10px; text-align: left; font-weight: 500; font-size: 11px; color: var(--color-text-secondary); background: var(--color-background-secondary); cursor: pointer; user-select: none; border-bottom: 0.5px solid var(--color-border-tertiary); white-space: nowrap; }\nth:hover { color: var(--color-text-primary); }\nth .si { margin-left: 3px; opacity: .4; font-size: 10px; }\nth.active .si { opacity: 1; }\ntd { padding: 6px 10px; border-bottom: 0.5px solid var(--color-border-tertiary); color: var(--color-text-primary); vertical-align: middle; }\ntr:last-child td { border-bottom: none; }\ntr:hover td { background: var(--color-background-secondary); }\n.docs { font-variant-numeric: tabular-nums; text-align: right; white-space: nowrap; }\n.bar-cell { padding: 6px 10px; min-width: 130px; }\n.bar-bg { background: var(--color-background-secondary); border-radius: 3px; height: 7px; position: relative; overflow: hidden; }\n.bar-fill { height: 100%; border-radius: 3px; background: #185FA5; position: absolute; left: 0; top: 0; }\n.year-label { font-size: 10px; color: var(--color-text-secondary); margin-top: 2px; }\n.sources-cell { white-space: nowrap; }\n.src-badge { display: inline-block; font-size: 10px; padding: 2px 6px; border-radius: var(--border-radius-md); margin: 1px 2px 1px 0; text-decoration: none; font-weight: 500; }\n.s-pm  { background:#E6F1FB; color:#0C447C; }\n.s-ps  { background:#EAF3DE; color:#27500A; }\n.s-pl  { background:#FAEEDA; color:#633806; }\n.s-pe  { background:#FBEAF0; color:#72243E; }\n.s-hm  { background:#EEEDFE; color:#3C3489; }\n.s-mp  { background:#E1F5EE; color:#085041; }\n.s-add { background:#F1EFE8; color:#444441; }\n.note  { font-size: 10px; color: var(--color-text-secondary); max-width: 160px; white-space: normal; line-height: 1.4; }\n.footer { font-size: 12px; color: var(--color-text-secondary); margin-top: .75rem; }\n.no-results { text-align: center; padding: 2rem; color: var(--color-text-secondary); font-size: 14px; }\n.legend { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 1rem; font-size: 11px; }\n.legend a { text-decoration: none; }\n.legend a:hover { text-decoration: underline; }\n<\/style>\n\n<div class=\"wrap\">\n  <h2 style=\"position:absolute;left:-9999px\" aria-hidden=\"false\">Corpus coverage explorer — 35 countries/regions, sources and document counts<\/h2>\n\n  <div class=\"summary-row\" id=\"summaryRow\"><\/div>\n\n  <div class=\"legend\">\n    <a href=\"https://www.clarin.eu/parlamint\" class=\"src-badge s-pm\">ParlaMint<\/a>\n    <a href=\"https://dataverse.harvard.edu/citation?persistentId=doi:10.7910/DVN/L4OAKN\" class=\"src-badge s-ps\">ParlSpeech V2<\/a>\n    <a href=\"https://parllawspeech.org/data/\" class=\"src-badge s-pl\">ParlLawSpeech<\/a>\n    <a href=\"https://pureportal.strath.ac.uk/en/datasets/parlee-plenary-speeches-v2-data-set-annotated-full-text-of-151-mi/\" class=\"src-badge s-pe\">ParlEE<\/a>\n    <a href=\"https://dataverse.harvard.edu/dataset.xhtml?persistentId=doi:10.7910/DVN/HISX4G\" class=\"src-badge s-hm\">HOME<\/a>\n    <a href=\"https://dataverse.harvard.edu/dataset.xhtml?persistentId=doi:10.7910/DVN/9MN0RL\" class=\"src-badge s-mp\">MAPLE<\/a>\n  <\/div>\n\n  <div class=\"controls\">\n    <input type=\"text\" id=\"searchBox\" placeholder=\"Search country…\" oninput=\"render()\" />\n    <select id=\"sortCol\" onchange=\"render()\">\n      <option value=\"country\">Sort: country A–Z<\/option>\n      <option value=\"docs_desc\">Sort: most documents<\/option>\n      <option value=\"docs_asc\">Sort: fewest documents<\/option>\n      <option value=\"start_asc\">Sort: earliest start<\/option>\n      <option value=\"end_desc\">Sort: most recent end<\/option>\n    <\/select>\n  <\/div>\n\n  <div class=\"tbl-wrap\">\n    <table>\n      <thead>\n        <tr>\n          <th onclick=\"setSort('country')\" id=\"th-country\" style=\"min-width:130px\">Country <span class=\"si\">↕<\/span><\/th>\n          <th onclick=\"setSort('docs_desc')\" id=\"th-docs\" style=\"text-align:right\">Documents <span class=\"si\">↕<\/span><\/th>\n          <th onclick=\"setSort('start_asc')\" id=\"th-start\">Start <span class=\"si\">↕<\/span><\/th>\n          <th onclick=\"setSort('end_desc')\" id=\"th-end\">End <span class=\"si\">↕<\/span><\/th>\n          <th style=\"min-width:130px\">Coverage<\/th>\n          <th style=\"min-width:200px\">Sources<\/th>\n          <th style=\"min-width:150px\">Metadata<\/th>\n        <\/tr>\n      <\/thead>\n      <tbody id=\"tbody\"><\/tbody>\n    <\/table>\n  <\/div>\n  <div class=\"footer\" id=\"footerLine\"><\/div>\n<\/div>\n\n<script>\nconst URLS = {\n  pm: \"https://www.clarin.eu/parlamint\",\n  ps: \"https://dataverse.harvard.edu/citation?persistentId=doi:10.7910/DVN/L4OAKN\",\n  pl: \"https://parllawspeech.org/data/\",\n  pe: \"https://pureportal.strath.ac.uk/en/datasets/parlee-plenary-speeches-v2-data-set-annotated-full-text-of-151-mi/\",\n  hm: \"https://dataverse.harvard.edu/dataset.xhtml?persistentId=doi:10.7910/DVN/HISX4G\",\n  mp: \"https://dataverse.harvard.edu/dataset.xhtml?persistentId=doi:10.7910/DVN/9MN0RL\"\n};\nconst LABELS = { pm:\"ParlaMint\", ps:\"ParlSpeech V2\", pl:\"ParlLawSpeech\", pe:\"ParlEE\", hm:\"HOME\", mp:\"MAPLE\" };\nconst CSS    = { pm:\"s-pm\", ps:\"s-ps\", pl:\"s-pl\", pe:\"s-pe\", hm:\"s-hm\", mp:\"s-mp\" };\n\nfunction badge(key) {\n  return `<a href=\"${URLS[key]}\" class=\"src-badge ${CSS[key]}\" target=\"_blank\" rel=\"noopener\">${LABELS[key]}<\/a>`;\n}\n\n// [country, docs, start, end, sources[], note]\nconst RAW = [\n  [\"Austria\",        2022212, 1996, 2022, [\"pm\",\"ps\",\"pl\",\"pe\"], \"\"],\n  [\"Belgium\",        670412,  2009, 2022, [\"pm\",\"pe\",\"mp\"],      \"\"],\n  [\"Bosnia and Herzegovina\", 126252, 1998, 2022, [\"pm\"],         \"\"],\n  [\"Bulgaria\",       210018,  2014, 2022, [\"pm\"],                \"\"],\n  [\"Croatia\",        734415,  2003, 2022, [\"pm\",\"pl\"],           \"\"],\n  [\"Czech Republic\", 689692,  1993, 2023, [\"pm\",\"ps\",\"pl\"],      \"\"],\n  [\"Denmark\",        1771779, 1997, 2021, [\"pm\",\"ps\",\"pl\"],      \"\"],\n  [\"Estonia\",        227872,  2011, 2022, [\"pm\"],                \"\"],\n  [\"European Union\", 574119,  1999, 2024, [\"pl\"],                \"\"],\n  [\"Finland\",        146858,  2015, 2022, [\"pm\"],                \"\"],\n  [\"France\",         5387336, 2009, 2022, [\"pm\",\"pe\"],           \"\"],\n  [\"Germany\",        3271713, 1991, 2021, [\"ps\",\"pl\",\"pe\"],      \"\"],\n  [\"Ghana\",          352280,  2005, 2024, [\"hm\"],                \"\"],\n  [\"Great Britain\",  9177947, 1988, 2022, [\"pm\",\"ps\",\"pe\"],      \"No speaker birth information in ParlaMint\"],\n  [\"Greece\",         1623192, 1989, 2022, [\"pm\",\"mp\"],           \"Additional data 1989–2020 with extended metadata (merging difficult)\"],\n  [\"Hungary\",        2278295, 1994, 2022, [\"pm\",\"pl\",\"pe\"],      \"\"],\n  [\"Iceland\",        95286,   2015, 2022, [\"pm\"],                \"\"],\n  [\"Ireland\",        21517564,1919, 2019, [\"pe\",\"mp\"],           \"Additional single-source corpus 1919–2013\"],\n  [\"Italy\",          2627514, 1948, 2022, [\"pm\"],                \"Additional corpus 1948–2022 (Joshua Cova)\"],\n  [\"Latvia\",         660012,  1993, 2022, [\"pm\"],                \"No speaker birth information in ParlaMint; additional single-source corpus 1993–\"],\n  [\"Netherlands\",    1752614, 1994, 2022, [\"pm\",\"ps\"],           \"\"],\n  [\"New Zealand\",    925766,  1987, 2019, [\"ps\"],                \"\"],\n  [\"Norway\",         398809,  1998, 2022, [\"pm\"],                \"\"],\n  [\"Poland\",         14874946,1919, 2025, [\"pm\"],                \"Additional: Polish Parliamentary Corpus (1919–2025)\"],\n  [\"Portugal\",       1472804, 2009, 2022, [\"pm\",\"pe\",\"mp\"],      \"\"],\n  [\"Serbia\",         316069,  1997, 2022, [\"pm\"],                \"\"],\n  [\"Slovenia\",       311354,  2000, 2022, [\"pm\"],                \"\"],\n  [\"South Africa\",   309716,  1999, 2024, [\"hm\"],                \"\"],\n  [\"Spain\",          638060,  1996, 2023, [\"pm\",\"ps\",\"pl\"],      \"\"],\n  [\"Spain (Basque)\", 39148,   2015, 2022, [\"pm\"],                \"\"],\n  [\"Spain (Catalonia)\",50824, 2015, 2022, [\"pm\"],                \"\"],\n  [\"Spain (Galicia)\",83078,   2015, 2022, [\"pm\"],                \"\"],\n  [\"Sweden\",         450222,  1990, 2022, [\"pm\",\"ps\"],           \"No speaker birth information\"],\n  [\"Turkey\",         681052,  2011, 2022, [\"pm\"],                \"\"],\n  [\"Ukraine\",        429437,  2002, 2023, [\"pm\"],                \"\"],\n];\n\nconst MIN_YEAR = 1919, MAX_YEAR = 2025;\nlet sortKey = 'country';\n\nfunction setSort(k) {\n  sortKey = k;\n  document.querySelectorAll('th').forEach(t => t.classList.remove('active'));\n  const map = {country:'th-country',docs_desc:'th-docs',docs_asc:'th-docs',start_asc:'th-start',end_desc:'th-end'};\n  if (map[k]) document.getElementById(map[k])?.classList.add('active');\n  render();\n}\n\nfunction fmt(n) { return n.toLocaleString('en-GB'); }\n\nfunction render() {\n  const q = document.getElementById('searchBox').value.toLowerCase();\n  const key = document.getElementById('sortCol').value || sortKey;\n  let rows = RAW.filter(r => r[0].toLowerCase().includes(q));\n  rows.sort((a,b) => {\n    if (key==='country')   return a[0].localeCompare(b[0]);\n    if (key==='docs_desc') return b[1]-a[1];\n    if (key==='docs_asc')  return a[1]-b[1];\n    if (key==='start_asc') return a[2]-b[2];\n    if (key==='end_desc')  return b[3]-a[3];\n    return 0;\n  });\n\n  const tbody = document.getElementById('tbody');\n  if (!rows.length) {\n    tbody.innerHTML = `<tr><td colspan=\"7\" class=\"no-results\">No countries match your search.<\/td><\/tr>`;\n  } else {\n    tbody.innerHTML = rows.map(r => {\n      const [country, docs, start, end, sources, note] = r;\n      const span = MAX_YEAR - MIN_YEAR;\n      const lp = Math.round(((start - MIN_YEAR) / span) * 100);\n      const wp = Math.max(2, Math.round(((end - start) / span) * 100));\n      const badges = sources.map(badge).join('');\n      return `<tr>\n        <td>${country}<\/td>\n        <td class=\"docs\">${fmt(docs)}<\/td>\n        <td>${start}<\/td>\n        <td>${end}<\/td>\n        <td class=\"bar-cell\">\n          <div class=\"bar-bg\" title=\"${start}–${end}\">\n            <div class=\"bar-fill\" style=\"left:${lp}%;width:${wp}%\"><\/div>\n          <\/div>\n          <div class=\"year-label\">${start}–${end}<\/div>\n        <\/td>\n        <td class=\"sources-cell\">${badges}<\/td>\n        <td class=\"note\">${note || '<span style=\"color:var(--color-text-secondary)\">—<\/span>'}<\/td>\n      <\/tr>`;\n    }).join('');\n  }\n\n  const totalDocs = rows.reduce((s,r)=>s+r[1],0);\n  const avgSpan = rows.length ? Math.round(rows.reduce((s,r)=>s+(r[3]-r[2]),0)/rows.length) : 0;\n  document.getElementById('summaryRow').innerHTML = `\n    <div class=\"metric\"><div class=\"metric-label\">Countries shown<\/div><div class=\"metric-value\">${rows.length}<\/div><\/div>\n    <div class=\"metric\"><div class=\"metric-label\">Documents (filtered)<\/div><div class=\"metric-value\">${fmt(totalDocs)}<\/div><\/div>\n    <div class=\"metric\"><div class=\"metric-label\">Avg. coverage span<\/div><div class=\"metric-value\">${avgSpan} yrs<\/div><\/div>\n  `;\n  document.getElementById('footerLine').textContent = `Showing ${rows.length} of ${RAW.length} countries · ${fmt(totalDocs)} documents`;\n}\nrender();\n<\/script>\n","type":"text"}]
