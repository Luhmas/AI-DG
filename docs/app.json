[{"name":"app.R","content":"#\n# This is a Shiny web application. You can run the application by clicking\n# the 'Run App' button above.\n#\n# Find out more about building applications with Shiny here:\n#\n#    https://shiny.posit.co/\n#\n\nlibrary(shiny)\n\n# Helper function to generate a collaborator row\ncollaborator_row <- function(name, institution) {\n  div(style = \"display: flex; justify-content: space-between; align-items: baseline; padding: 10px 0; border-bottom: 1px solid #e8e8e8;\",\n      span(style = \"font-size: 14px; font-weight: 500;\", name),\n      span(style = \"font-size: 13px; color: #888;\", institution)\n  )\n}\n\nui <- fluidPage(\n  \n  tabsetPanel(\n    \n    tabPanel(\"Overview\",\n             br(),\n             \n             # Hero\n             div(style = \"padding-bottom: 1.5rem; border-bottom: 1px solid #e0e0e0; margin-bottom: 2rem;\",\n                 p(\"Social Science Text Data Initiative\", style = \"font-size: 12px; text-transform: uppercase; letter-spacing: .05em; color: #888; margin-bottom: .5rem;\"),\n                 h1(\"AI-DG — Avoid Inefficient Data Generation\", style = \"font-size: 26px; font-weight: 500; margin-bottom: .75rem;\"),\n                 p(\"A network of scholars collecting or planning to collect social science text data, working together to avoid duplication and build better datasets.\",\n                   style = \"font-size: 15px; color: #555; max-width: 580px; line-height: 1.7;\")\n             ),\n             \n             # Why section\n             h5(\"WHY AI-DG\", style = \"font-size: 11px; text-transform: uppercase; letter-spacing: .06em; color: #888; margin-bottom: 1rem;\"),\n             fluidRow(\n               column(4, div(style = \"border: 1px solid #e8e8e8; border-radius: 10px; padding: 1rem 1.25rem; margin-bottom: 12px; height: 100%;\",\n                             h6(\"Avoid duplication\", style = \"font-weight: 500; margin-bottom: .3rem;\"),\n                             p(\"Many datasets are developed in isolation, often simultaneously, wasting resources on parallel efforts.\",\n                               style = \"font-size: 13px; color: #666; margin: 0;\")\n               )),\n               column(4, div(style = \"border: 1px solid #e8e8e8; border-radius: 10px; padding: 1rem 1.25rem; margin-bottom: 12px; height: 100%;\",\n                             h6(\"Enable collaboration\", style = \"font-weight: 500; margin-bottom: .3rem;\"),\n                             p(\"Early coordination helps identify synergies, share resources, and exchange knowledge.\",\n                               style = \"font-size: 13px; color: #666; margin: 0;\")\n               )),\n               column(4, div(style = \"border: 1px solid #e8e8e8; border-radius: 10px; padding: 1rem 1.25rem; margin-bottom: 12px; height: 100%;\",\n                             h6(\"Common standards\", style = \"font-weight: 500; margin-bottom: .3rem;\"),\n                             p(\"Identify gaps and develop shared metadata standards across projects and research groups.\",\n                               style = \"font-size: 13px; color: #666; margin: 0;\")\n               ))\n             ),\n             br(),\n             \n             # What we provide\n             h5(\"WHAT WE PROVIDE\", style = \"font-size: 11px; text-transform: uppercase; letter-spacing: .06em; color: #888; margin-bottom: 1rem;\"),\n             div(style = \"display: flex; flex-direction: column; gap: 10px;\",\n                 div(style = \"display: flex; gap: 12px;\",\n                     div(style = \"width:24px; height:24px; border-radius:50%; background:#f0f0f0; display:flex; align-items:center; justify-content:center; font-size:12px; font-weight:500; color:#666; flex-shrink:0;\", \"1\"),\n                     div(h6(\"Researcher network\", style = \"margin-bottom:3px; font-weight:500;\"),\n                         p(\"A large network supported by an AI-powered search tool to connect researchers working on similar data collection projects.\", style = \"font-size:13px; color:#666; margin:0;\"))\n                 ),\n                 div(style = \"display: flex; gap: 12px;\",\n                     div(style = \"width:24px; height:24px; border-radius:50%; background:#f0f0f0; display:flex; align-items:center; justify-content:center; font-size:12px; font-weight:500; color:#666; flex-shrink:0;\", \"2\"),\n                     div(h6(\"Dataset overview\", style = \"margin-bottom:3px; font-weight:500;\"),\n                         p(\"An overview that surveys existing text datasets and those currently under development.\", style = \"font-size:13px; color:#666; margin:0;\"))\n                 ),\n                 div(style = \"display: flex; gap: 12px;\",\n                     div(style = \"width:24px; height:24px; border-radius:50%; background:#f0f0f0; display:flex; align-items:center; justify-content:center; font-size:12px; font-weight:500; color:#666; flex-shrink:0;\", \"3\"),\n                     div(h6(\"Regular updates\", style = \"margin-bottom:3px; font-weight:500;\"),\n                         p(\"Updates on ongoing social science text data projects and newly released datasets relevant to the community, with the opportunity to participate for joint effort.\", style = \"font-size:13px; color:#666; margin:0;\"))\n                 )\n             ),\n             br(),\n             \n             # Join box\n             h5(\"JOIN AI-DG\", style = \"font-size: 11px; text-transform: uppercase; letter-spacing: .06em; color: #888; margin-bottom: 1rem;\"),\n             div(style = \"background: #f8f8f6; border-radius: 10px; padding: 1.25rem 1.5rem; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem;\",\n                 div(\n                   h6(\"Become a collaborator\", style = \"font-weight: 500; margin-bottom: 4px;\"),\n                   p(\"As we present AI-DG to the broader research community, you are welcome to join as an official collaborator. Below you can find a list with all the reseachers who have already joined as official collaborators.\",\n                     style = \"font-size: 13px; color: #666; margin: 0;\")\n                 ),\n                 \n                 div(style = \"display: flex; gap: 8px; flex-wrap: wrap;\",\n                     \n                     tags$a(href = \"mailto:Leonce.Roeth@gsi.uni-muenchen.de\",\n                            style = \"background: white; border: 1px solid #e0e0e0; border-radius: 8px; padding: 6px 12px; font-size: 13px; text-decoration: none; color: inherit;\",\n                            \"✉ Leonce\"\n                     ),\n                     \n                     tags$a(href = \"mailto:luck@soz.uni-frankfurt.de\",\n                            style = \"background: white; border: 1px solid #e0e0e0; border-radius: 8px; padding: 6px 12px; font-size: 13px; text-decoration: none; color: inherit;\",\n                            \"✉ Simon\"\n                     )\n                 )\n             ),\n             \n             br(),\n             \n             # List of collaborators\n             h5(\"AI-DG\", style = \"font-size: 11px; text-transform: uppercase; letter-spacing: .06em; color: #888; margin-bottom: 1rem;\"),\n             div(style = \"display: flex; flex-direction: column;\",\n                 collaborator_row(\"Jakob Berg\", \"University of Regensburg\"),\n                 collaborator_row(\"Matthias Brunn\", \"EUI\"),\n                 collaborator_row(\"Paride Carrara\", \"University of Latvia/University of Milan\"),\n                 collaborator_row(\"Joshua Cova\", \"Max Planck Institute for the Study of Societies\"),\n                 collaborator_row(\"Simon Franzmann\", \"University of Göttingen\"),\n                 collaborator_row(\"Julian Garritzmann\", \"Goethe University Frankfurt\"),\n                 collaborator_row(\"Daniela Grünow\", \"Goethe University Frankfurt\"),\n                 collaborator_row(\"Christoph Ivanusch\", \"LMU Munich\"),\n                 collaborator_row(\"Malo Jan\", \"Science Po Paris\"),\n                 collaborator_row(\"Pola Lehman\", \"Social Science Center Berlin\"),\n                 collaborator_row(\"Christian Rauh\", \"Social Science Center Berlin/University of Potsdam\"),\n                 collaborator_row(\"Ingo Rohlfing\", \"University of Passau\"),\n                 collaborator_row(\"Nelson Santos\", \"Université de Namur\"),\n                 collaborator_row(\"Luis Sattelmayer\", \"Science Po Paris\"),\n                 collaborator_row(\"Lucas Schramm\", \"LMU Munich\"),\n                 collaborator_row(\"Jan Schwalbach\", \"GESIS\"),\n                 collaborator_row(\"Michele Scotto di Vettimo\", \"Kings College London\"),\n                 collaborator_row(\"Miklós Sebők\", \"poltextLAB\"),\n                 collaborator_row(\"Sophie Suda\", \"University of Basel\"),\n                 collaborator_row(\"Aidar Zinnatullin\", \"RPTU University Kaiserslautern-Landau\")\n             )\n    ),\n    \n    tabPanel(\"Data Portal\",\n             h1(\"Data Overview\"),\n             tags$iframe(\n               src = \"corpus_coverage_explorer.html\",\n               width = \"100%\",\n               height = \"800px\",\n               style = \"border: none;\"\n             )\n    )\n    \n  ) \n)\n\n# Define server logic required to draw a histogram\nserver <- function(input, output) {}\n\n# Run the application \nshinyApp(ui = ui, server = server)\n","type":"text"},{"name":"corpus_coverage_explorer_alt.html","content":"\n<style>\n* { box-sizing: border-box; margin: 0; padding: 0; }\nbody { font-family: var(--font-sans); }\n.wrap { padding: 1rem 0; }\n.summary-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-bottom: 1.25rem; }\n.metric { background: var(--color-background-secondary); border-radius: var(--border-radius-md); padding: .75rem 1rem; }\n.metric-label { font-size: 12px; color: var(--color-text-secondary); margin-bottom: 4px; }\n.metric-value { font-size: 20px; font-weight: 500; color: var(--color-text-primary); }\n.controls { display: flex; gap: 10px; margin-bottom: 1rem; }\n.controls input { flex: 1; }\n.controls select { min-width: 140px; }\n.tbl-wrap { overflow-x: auto; border: 0.5px solid var(--color-border-tertiary); border-radius: var(--border-radius-lg); }\ntable { width: 100%; border-collapse: collapse; font-size: 13px; table-layout: fixed; }\nth { padding: 8px 12px; text-align: left; font-weight: 500; font-size: 12px; color: var(--color-text-secondary); background: var(--color-background-secondary); cursor: pointer; user-select: none; border-bottom: 0.5px solid var(--color-border-tertiary); white-space: nowrap; }\nth:hover { color: var(--color-text-primary); }\nth .sort-icon { margin-left: 4px; opacity: .4; font-size: 11px; }\nth.active .sort-icon { opacity: 1; }\ntd { padding: 7px 12px; border-bottom: 0.5px solid var(--color-border-tertiary); color: var(--color-text-primary); vertical-align: middle; }\ntr:last-child td { border-bottom: none; }\ntr:hover td { background: var(--color-background-secondary); }\ncol.c1 { width: 18%; }\ncol.c2 { width: 14%; }\ncol.c3 { width: 12%; }\ncol.c4 { width: 12%; }\ncol.c5 { width: 44%; }\n.docs { font-variant-numeric: tabular-nums; text-align: right; }\n.bar-cell { padding: 7px 12px; }\n.bar-bg { background: var(--color-background-secondary); border-radius: 3px; height: 8px; position: relative; overflow: hidden; }\n.bar-fill { height: 100%; border-radius: 3px; background: #185FA5; position: absolute; left: 0; top: 0; }\n.year-label { font-size: 11px; color: var(--color-text-secondary); margin-top: 3px; }\n.badge { display: inline-block; font-size: 11px; padding: 2px 7px; border-radius: var(--border-radius-md); background: var(--color-background-info); color: var(--color-text-info); }\n.footer { font-size: 12px; color: var(--color-text-secondary); margin-top: .75rem; }\n.no-results { text-align: center; padding: 2rem; color: var(--color-text-secondary); font-size: 14px; }\n<\/style>\n\n<div class=\"wrap\">\n  <h2 class=\"sr-only\" style=\"position:absolute;left:-9999px\">Corpus coverage explorer — 32 countries, 78.5M documents, 1919–2025<\/h2>\n\n  <div class=\"summary-row\" id=\"summaryRow\"><\/div>\n\n  <div class=\"controls\">\n    <input type=\"text\" id=\"searchBox\" placeholder=\"Search country…\" oninput=\"render()\" />\n    <select id=\"sortCol\" onchange=\"render()\">\n      <option value=\"country\">Sort: country A–Z<\/option>\n      <option value=\"docs_desc\">Sort: most documents<\/option>\n      <option value=\"docs_asc\">Sort: fewest documents<\/option>\n      <option value=\"start_asc\">Sort: earliest start<\/option>\n      <option value=\"end_desc\">Sort: most recent end<\/option>\n    <\/select>\n  <\/div>\n\n  <div class=\"tbl-wrap\">\n    <table>\n      <colgroup>\n        <col class=\"c1\"><col class=\"c2\"><col class=\"c3\"><col class=\"c4\"><col class=\"c5\">\n      <\/colgroup>\n      <thead>\n        <tr>\n          <th onclick=\"setSort('country')\" id=\"th-country\">Country <span class=\"sort-icon\">↕<\/span><\/th>\n          <th onclick=\"setSort('docs_desc')\" id=\"th-docs\" style=\"text-align:right\">Documents <span class=\"sort-icon\">↕<\/span><\/th>\n          <th onclick=\"setSort('start_asc')\" id=\"th-start\">Start <span class=\"sort-icon\">↕<\/span><\/th>\n          <th onclick=\"setSort('end_desc')\" id=\"th-end\">End <span class=\"sort-icon\">↕<\/span><\/th>\n          <th>Coverage period<\/th>\n        <\/tr>\n      <\/thead>\n      <tbody id=\"tbody\"><\/tbody>\n    <\/table>\n  <\/div>\n  <div class=\"footer\" id=\"footerLine\"><\/div>\n<\/div>\n\n<script>\nconst RAW = [\n  [\"Austria\",2022212,1996,2022],\n  [\"Belgium\",670412,2009,2022],\n  [\"Bosnia and Herzegovina\",126252,1998,2022],\n  [\"Bulgaria\",210018,2014,2022],\n  [\"Croatia\",734415,2003,2022],\n  [\"Czech Republic\",689692,1993,2023],\n  [\"Denmark\",1771779,1997,2021],\n  [\"Estonia\",227872,2011,2022],\n  [\"European Union\",574119,1999,2024],\n  [\"Finland\",146858,2015,2022],\n  [\"France\",5387336,2009,2022],\n  [\"Germany\",3271713,1991,2021],\n  [\"Ghana\",352280,2005,2024],\n  [\"Great Britain\",9177947,1988,2022],\n  [\"Greece\",1623192,1989,2022],\n  [\"Hungary\",2278295,1994,2022],\n  [\"Iceland\",95286,2015,2022],\n  [\"Ireland\",21517564,1919,2019],\n  [\"Italy\",2627514,1948,2022],\n  [\"Latvia\",660012,1993,2022],\n  [\"Netherlands\",1752614,1994,2022],\n  [\"New Zealand\",925766,1987,2019],\n  [\"Norway\",398809,1998,2022],\n  [\"Poland\",14874946,1919,2025],\n  [\"Portugal\",1472804,2009,2022],\n  [\"Serbia\",316069,1997,2022],\n  [\"Slovenia\",311354,2000,2022],\n  [\"South Africa\",309716,1999,2024],\n  [\"Spain\",638060,1996,2023],\n  [\"Spain (Basque)\",39148,2015,2022],\n  [\"Spain (Catalonia)\",50824,2015,2022],\n  [\"Spain (Galicia)\",83078,2015,2022],\n  [\"Sweden\",450222,1990,2022],\n  [\"Turkey\",681052,2011,2022],\n  [\"Ukraine\",429437,2002,2023],\n];\n\nconst MIN_YEAR = 1919, MAX_YEAR = 2025;\nlet sortKey = 'country';\n\nfunction setSort(k) {\n  sortKey = k;\n  document.querySelectorAll('th').forEach(t => t.classList.remove('active'));\n  const map = {country:'th-country',docs_desc:'th-docs',docs_asc:'th-docs',start_asc:'th-start',end_desc:'th-end'};\n  if (map[k]) document.getElementById(map[k])?.classList.add('active');\n  render();\n}\n\nfunction fmt(n) { return n.toLocaleString('en-GB'); }\n\nfunction render() {\n  const q = document.getElementById('searchBox').value.toLowerCase();\n  const sortSel = document.getElementById('sortCol').value;\n  const key = sortSel || sortKey;\n\n  let rows = RAW.filter(r => r[0].toLowerCase().includes(q));\n\n  rows.sort((a,b) => {\n    if (key==='country') return a[0].localeCompare(b[0]);\n    if (key==='docs_desc') return b[1]-a[1];\n    if (key==='docs_asc') return a[1]-b[1];\n    if (key==='start_asc') return a[2]-b[2];\n    if (key==='end_desc') return b[3]-a[3];\n    return 0;\n  });\n\n  const tbody = document.getElementById('tbody');\n  if (rows.length === 0) {\n    tbody.innerHTML = `<tr><td colspan=\"5\" class=\"no-results\">No countries match your search.<\/td><\/tr>`;\n  } else {\n    tbody.innerHTML = rows.map(r => {\n      const [country, docs, start, end] = r;\n      const span = MAX_YEAR - MIN_YEAR;\n      const leftPct = Math.round(((start - MIN_YEAR) / span) * 100);\n      const widthPct = Math.max(2, Math.round(((end - start) / span) * 100));\n      return `<tr>\n        <td>${country}<\/td>\n        <td class=\"docs\">${fmt(docs)}<\/td>\n        <td>${start}<\/td>\n        <td>${end}<\/td>\n        <td class=\"bar-cell\">\n          <div class=\"bar-bg\" title=\"${start}–${end}\">\n            <div class=\"bar-fill\" style=\"left:${leftPct}%;width:${widthPct}%\"><\/div>\n          <\/div>\n          <div class=\"year-label\">${MIN_YEAR} ← ${start}–${end} → ${MAX_YEAR}<\/div>\n        <\/td>\n      <\/tr>`;\n    }).join('');\n  }\n\n  const totalDocs = rows.reduce((s,r)=>s+r[1],0);\n  const avgSpan = rows.length ? Math.round(rows.reduce((s,r)=>s+(r[3]-r[2]),0)/rows.length) : 0;\n  document.getElementById('summaryRow').innerHTML = `\n    <div class=\"metric\"><div class=\"metric-label\">Countries shown<\/div><div class=\"metric-value\">${rows.length}<\/div><\/div>\n    <div class=\"metric\"><div class=\"metric-label\">Documents (filtered)<\/div><div class=\"metric-value\">${fmt(totalDocs)}<\/div><\/div>\n    <div class=\"metric\"><div class=\"metric-label\">Avg. coverage span<\/div><div class=\"metric-value\">${avgSpan} yrs<\/div><\/div>\n  `;\n  document.getElementById('footerLine').textContent = `Showing ${rows.length} of ${RAW.length} countries · ${fmt(totalDocs)} documents`;\n}\n\nrender();\n<\/script>\n","type":"text"},{"name":"www/corpus_coverage_explorer.html","content":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Corpus Coverage Explorer<\/title>\n<style>\n* { box-sizing: border-box; margin: 0; padding: 0; }\nbody { font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif; background: #fff; color: #111; padding: 1.25rem; }\nh2.title { font-size: 18px; font-weight: 500; margin-bottom: 4px; }\n.subtitle { font-size: 13px; color: #666; margin-bottom: 1.5rem; line-height: 1.7; }\n.summary-row { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin-bottom: 1.25rem; }\n.metric { background: #f7f7f5; border-radius: 8px; padding: .75rem 1rem; }\n.metric-label { font-size: 11px; color: #888; margin-bottom: 4px; }\n.metric-value { font-size: 17px; font-weight: 500; color: #111; }\n.legend { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: .75rem; align-items: center; font-size: 12px; color: #888; }\n.legend-label { margin-right: 2px; }\n.src-badge { display: inline-block; font-size: 10px; padding: 2px 6px; border-radius: 4px; text-decoration: none; font-weight: 500; }\n.s-pm  { background:#E6F1FB; color:#0C447C; }\n.s-ps  { background:#EAF3DE; color:#27500A; }\n.s-pl  { background:#FAEEDA; color:#633806; }\n.s-pe  { background:#FBEAF0; color:#72243E; }\n.s-hm  { background:#EEEDFE; color:#3C3489; }\n.s-mp  { background:#E1F5EE; color:#085041; }\n.s-ex  { background:#F1EFE8; color:#555550; }\n.tabs { display: flex; border-bottom: 1px solid #e0e0e0; margin-bottom: 1rem; }\n.tab { padding: 7px 16px; font-size: 13px; cursor: pointer; color: #888; border-bottom: 2px solid transparent; margin-bottom: -1px; background: none; border-top: none; border-left: none; border-right: none; font-family: inherit; }\n.tab.active { color: #111; border-bottom-color: #111; font-weight: 500; }\n/* TABLE */\n#table-view { display: block; }\n#timeline-view { display: none; }\n.controls { display: flex; gap: 10px; margin-bottom: 1rem; flex-wrap: wrap; }\n.controls input, .controls select { font-family: inherit; font-size: 13px; padding: 6px 10px; border: 1px solid #e0e0e0; border-radius: 6px; background: #fff; color: #111; }\n.controls input { flex: 1; min-width: 140px; }\n.controls select { min-width: 160px; }\n.tbl-wrap { overflow-x: auto; border: 1px solid #e8e8e8; border-radius: 10px; }\ntable { width: 100%; border-collapse: collapse; font-size: 12px; }\nth { padding: 8px 10px; text-align: left; font-weight: 500; font-size: 11px; color: #888; background: #f7f7f5; cursor: pointer; user-select: none; border-bottom: 1px solid #e8e8e8; white-space: nowrap; }\nth:hover { color: #111; }\nth .si { margin-left: 3px; opacity:.4; font-size:10px; }\nth.active .si { opacity:1; }\ntd { padding: 6px 10px; border-bottom: 1px solid #f0f0f0; color: #111; vertical-align: middle; }\ntr:last-child td { border-bottom: none; }\ntr:hover td { background: #fafafa; }\n.docs { font-variant-numeric: tabular-nums; text-align: right; white-space: nowrap; }\n.bar-cell { padding: 6px 10px; min-width: 110px; }\n.bar-bg { background: #f0f0f0; border-radius: 3px; height: 7px; position: relative; overflow: hidden; }\n.bar-fill { height: 100%; border-radius: 3px; background: #185FA5; position: absolute; left: 0; top: 0; }\n.year-label { font-size: 10px; color: #999; margin-top: 2px; }\n.sources-cell { white-space: nowrap; }\n.parl-link { font-size: 12px; color: #185FA5; text-decoration: none; }\n.parl-link:hover { text-decoration: underline; }\n.note { font-size: 11px; color: #888; max-width: 140px; white-space: normal; line-height: 1.4; }\n.footer { font-size: 12px; color: #999; margin-top: .75rem; }\n.no-results { text-align: center; padding: 2rem; color: #999; font-size: 14px; }\n/* TIMELINE */\n.tl-container { width: 100%; overflow-x: auto; }\n.tl-row-wrap { display: flex; align-items: center; gap: 8px; margin-bottom: 4px; min-width: 500px; }\n.tl-label { font-size: 11px; color: #111; width: 150px; flex-shrink: 0; text-align: right; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; transition: opacity .15s; }\n.tl-track { flex: 1; background: #f0f0f0; border-radius: 3px; height: 11px; position: relative; cursor: pointer; }\n.tl-bar { height: 100%; border-radius: 3px; background: #185FA5; position: absolute; top: 0; transition: opacity .15s; }\n.tl-axis-row { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; min-width: 500px; }\n.tl-axis-spacer { width: 150px; flex-shrink: 0; }\n.tl-axis-track { flex: 1; position: relative; height: 16px; }\n.tl-axis-label { position: absolute; font-size: 10px; color: #999; transform: translateX(-50%); }\n/* tooltip */\n#tl-tooltip {\n  position: fixed;\n  background: #fff;\n  border: 1px solid #e0e0e0;\n  border-radius: 10px;\n  padding: 10px 14px;\n  font-size: 12px;\n  pointer-events: none;\n  z-index: 9999;\n  display: none;\n  max-width: 260px;\n  box-shadow: 0 4px 16px rgba(0,0,0,.1);\n}\n#tl-tooltip .tt-name { font-weight: 500; font-size: 13px; color: #111; margin-bottom: 6px; }\n#tl-tooltip .tt-row { display: flex; justify-content: space-between; gap: 16px; color: #888; margin-bottom: 3px; }\n#tl-tooltip .tt-val { color: #111; font-weight: 500; }\n#tl-tooltip .tt-sources { margin-top: 6px; display: flex; flex-wrap: wrap; gap: 4px; }\n.dimmed .tl-label { opacity: .15; }\n.dimmed .tl-bar { opacity: .1; }\n<\/style>\n<\/head>\n<body>\n\n<h2 class=\"title\">Data Overview<\/h2>\n<p class=\"subtitle\">Our thanks and credit go to everyone who has compiled these datasets. This serves as an overview of the existing data, and we have taken great care to ensure that all sources are cited correctly and in full. If you notice any errors or if any information is missing, please contact <a href=\"mailto:luck@soz.uni-frankfurt.de\" style=\"color:#888\">luck@soz.uni-frankfurt.de<\/a>.<\/p>\n\n<div class=\"summary-row\" id=\"summaryRow\"><\/div>\n\n<div class=\"legend\">\n  <span class=\"legend-label\">Sources:<\/span>\n  <a href=\"https://www.clarin.eu/parlamint\" class=\"src-badge s-pm\" target=\"_blank\">ParlaMint<\/a>\n  <a href=\"https://dataverse.harvard.edu/citation?persistentId=doi:10.7910/DVN/L4OAKN\" class=\"src-badge s-ps\" target=\"_blank\">ParlSpeech V2<\/a>\n  <a href=\"https://parllawspeech.org/data/\" class=\"src-badge s-pl\" target=\"_blank\">ParlLawSpeech<\/a>\n  <a href=\"https://pureportal.strath.ac.uk/en/datasets/parlee-plenary-speeches-v2-data-set-annotated-full-text-of-151-mi/\" class=\"src-badge s-pe\" target=\"_blank\">ParlEE<\/a>\n  <a href=\"https://dataverse.harvard.edu/dataset.xhtml?persistentId=doi:10.7910/DVN/HISX4G\" class=\"src-badge s-hm\" target=\"_blank\">HOME<\/a>\n  <a href=\"https://dataverse.harvard.edu/dataset.xhtml?persistentId=doi:10.7910/DVN/9MN0RL\" class=\"src-badge s-mp\" target=\"_blank\">MAPLE<\/a>\n  <a href=\"https://dataverse.harvard.edu/dataset.xhtml?persistentId=doi:10.7910/DVN/KUARWD\" class=\"src-badge s-ex\" target=\"_blank\">ItaParlCorpus<\/a>\n  <a href=\"https://github.com/DominikBeese/DeuParl-v2\" class=\"src-badge s-ex\" target=\"_blank\">DeuParl<\/a>\n  <a href=\"https://github.com/PolMine/GermaParlTEI\" class=\"src-badge s-ex\" target=\"_blank\">GermaParl<\/a>\n  <a href=\"https://louwerse.github.io/dutchparl/\" class=\"src-badge s-ex\" target=\"_blank\">DutchParl<\/a>\n  <a href=\"https://zenodo.org/records/3831472\" class=\"src-badge s-ex\" target=\"_blank\">UNGA<\/a>\n  <a href=\"https://polmine.github.io/MigParl/\" class=\"src-badge s-ex\" target=\"_blank\">MigParl<\/a>\n  <a href=\"https://zenodo.org/records/3819374\" class=\"src-badge s-ex\" target=\"_blank\">ParisParl<\/a>\n  <a href=\"https://springernature.figshare.com/articles/dataset/Finnish_parliamentary_speeches_dataset/28028732\" class=\"src-badge s-ex\" target=\"_blank\">Finnish Speeches<\/a>\n  <a href=\"https://data.stanford.edu/congress_text\" class=\"src-badge s-ex\" target=\"_blank\">Stanford Congress<\/a>\n  <a href=\"https://dataverse.harvard.edu/dataset.xhtml?persistentId=doi:10.7910/DVN/6MZN76\" class=\"src-badge s-ex\" target=\"_blank\">Irish DB<\/a>\n  <a href=\"https://clip.ipipan.waw.pl/PPC\" class=\"src-badge s-ex\" target=\"_blank\">Polish Parl. Corpus<\/a>\n  <a href=\"https://dati.saeima.korpuss.lv/\" class=\"src-badge s-ex\" target=\"_blank\">LinkedSaeima<\/a>\n<\/div>\n\n<div class=\"tabs\">\n  <button class=\"tab active\" onclick=\"switchTab('table')\">Table<\/button>\n  <button class=\"tab\" onclick=\"switchTab('timeline')\">Timeline<\/button>\n<\/div>\n\n<div id=\"table-view\">\n  <div class=\"controls\">\n    <input type=\"text\" id=\"searchBox\" placeholder=\"Search country or parliament…\" oninput=\"renderTable()\" />\n    <select id=\"sortCol\" onchange=\"renderTable()\">\n      <option value=\"country\">Sort: country A–Z<\/option>\n      <option value=\"docs_desc\">Sort: most speeches<\/option>\n      <option value=\"docs_asc\">Sort: fewest speeches<\/option>\n      <option value=\"start_asc\">Sort: earliest start<\/option>\n      <option value=\"end_desc\">Sort: most recent end<\/option>\n    <\/select>\n  <\/div>\n  <div class=\"tbl-wrap\">\n    <table>\n      <thead>\n        <tr>\n          <th onclick=\"setSort('country')\" id=\"th-country\">Country <span class=\"si\">↕<\/span><\/th>\n          <th>Parliament<\/th>\n          <th onclick=\"setSort('docs_desc')\" id=\"th-docs\" style=\"text-align:right\">Speeches <span class=\"si\">↕<\/span><\/th>\n          <th onclick=\"setSort('start_asc')\" id=\"th-start\">Start <span class=\"si\">↕<\/span><\/th>\n          <th onclick=\"setSort('end_desc')\" id=\"th-end\">End <span class=\"si\">↕<\/span><\/th>\n          <th style=\"min-width:110px\">Coverage<\/th>\n          <th style=\"min-width:200px\">Sources<\/th>\n          <th style=\"min-width:130px\">Metadata<\/th>\n        <\/tr>\n      <\/thead>\n      <tbody id=\"tbody\"><\/tbody>\n    <\/table>\n  <\/div>\n  <div class=\"footer\" id=\"footerLine\"><\/div>\n<\/div>\n\n<div id=\"timeline-view\">\n  <div class=\"tl-container\" id=\"tlContainer\"><\/div>\n<\/div>\n\n<div id=\"tl-tooltip\">\n  <div class=\"tt-name\" id=\"tt-name\"><\/div>\n  <div class=\"tt-row\"><span>Period<\/span><span class=\"tt-val\" id=\"tt-period\"><\/span><\/div>\n  <div class=\"tt-row\"><span>Speeches<\/span><span class=\"tt-val\" id=\"tt-docs\"><\/span><\/div>\n  <div class=\"tt-sources\" id=\"tt-sources\"><\/div>\n<\/div>\n\n<script>\nvar URLS = {\n  pm:\"https://www.clarin.eu/parlamint\",\n  ps:\"https://dataverse.harvard.edu/citation?persistentId=doi:10.7910/DVN/L4OAKN\",\n  pl:\"https://parllawspeech.org/data/\",\n  pe:\"https://pureportal.strath.ac.uk/en/datasets/parlee-plenary-speeches-v2-data-set-annotated-full-text-of-151-mi/\",\n  hm:\"https://dataverse.harvard.edu/dataset.xhtml?persistentId=doi:10.7910/DVN/HISX4G\",\n  mp:\"https://dataverse.harvard.edu/dataset.xhtml?persistentId=doi:10.7910/DVN/9MN0RL\",\n  ita:\"https://dataverse.harvard.edu/dataset.xhtml?persistentId=doi:10.7910/DVN/KUARWD\",\n  deu:\"https://github.com/DominikBeese/DeuParl-v2\",\n  ger:\"https://github.com/PolMine/GermaParlTEI\",\n  dut:\"https://louwerse.github.io/dutchparl/\",\n  unga:\"https://zenodo.org/records/3831472\",\n  mig:\"https://polmine.github.io/MigParl/\",\n  par:\"https://zenodo.org/records/3819374\",\n  fin:\"https://springernature.figshare.com/articles/dataset/Finnish_parliamentary_speeches_dataset/28028732\",\n  std:\"https://data.stanford.edu/congress_text\",\n  irl:\"https://dataverse.harvard.edu/dataset.xhtml?persistentId=doi:10.7910/DVN/6MZN76\",\n  ppc:\"https://clip.ipipan.waw.pl/PPC\",\n  lnk:\"https://dati.saeima.korpuss.lv/\"\n};\nvar LABELS = {\n  pm:\"ParlaMint\",ps:\"ParlSpeech V2\",pl:\"ParlLawSpeech\",pe:\"ParlEE\",hm:\"HOME\",mp:\"MAPLE\",\n  ita:\"ItaParlCorpus\",deu:\"DeuParl\",ger:\"GermaParl\",dut:\"DutchParl\",unga:\"UNGA\",\n  mig:\"MigParl\",par:\"ParisParl\",fin:\"Finnish Speeches\",std:\"Stanford Congress\",\n  irl:\"Irish DB\",ppc:\"Polish Parl. Corpus\",lnk:\"LinkedSaeima\"\n};\nvar CSS = {\n  pm:\"s-pm\",ps:\"s-ps\",pl:\"s-pl\",pe:\"s-pe\",hm:\"s-hm\",mp:\"s-mp\",\n  ita:\"s-ex\",deu:\"s-ex\",ger:\"s-ex\",dut:\"s-ex\",unga:\"s-ex\",\n  mig:\"s-ex\",par:\"s-ex\",fin:\"s-ex\",std:\"s-ex\",irl:\"s-ex\",ppc:\"s-ex\",lnk:\"s-ex\"\n};\n\nfunction badge(key) {\n  return '<a href=\"'+URLS[key]+'\" class=\"src-badge '+CSS[key]+'\" target=\"_blank\" rel=\"noopener\">'+LABELS[key]+'<\/a>';\n}\n\n// [country, docs, start, end, sources[], note, parliament_name, parliament_url]\nvar RAW = [\n  [\"Austria\",2022212,1996,2022,[\"pm\",\"ps\",\"pl\",\"pe\"],\"tbd\",\"Nationalrat\",\"https://www.parlament.gv.at\"],\n  [\"Belgium\",670412,2009,2022,[\"pm\",\"pe\",\"mp\"],\"tbd\",\"Chambre/Kamer\",\"https://www.lachambre.be\"],\n  [\"Bosnia and Herzegovina\",126252,1998,2022,[\"pm\"],\"tbd\",\"Parlamentarna skupština\",\"https://www.parlament.ba\"],\n  [\"Bulgaria\",210018,2014,2022,[\"pm\"],\"tbd\",\"Narodno Sabranie\",\"https://www.parliament.bg\"],\n  [\"Croatia\",734415,2003,2022,[\"pm\",\"pl\"],\"tbd\",\"Hrvatski Sabor\",\"https://www.sabor.hr\"],\n  [\"Czech Republic\",689692,1993,2023,[\"pm\",\"ps\",\"pl\"],\"tbd\",\"Parlament České republiky\",\"https://www.psp.cz\"],\n  [\"Denmark\",1771779,1997,2021,[\"pm\",\"ps\",\"pl\"],\"tbd\",\"Folketing\",\"https://www.ft.dk\"],\n  [\"Estonia\",227872,2011,2022,[\"pm\"],\"tbd\",\"Riigikogu\",\"https://www.riigikogu.ee\"],\n  [\"European Union\",574119,1999,2024,[\"pl\"],\"tbd\",\"European Parliament\",\"https://www.europarl.europa.eu\"],\n  [\"Finland\",146858,1907,2022,[\"pm\",\"fin\"],\"tbd\",\"Eduskunta\",\"https://www.eduskunta.fi\"],\n  [\"France\",5387336,1996,2022,[\"pm\",\"pe\",\"par\"],\"tbd\",\"Assemblée Nationale\",\"https://www.assemblee-nationale.fr\"],\n  [\"Germany\",3271713,1867,2022,[\"ps\",\"pl\",\"pe\",\"deu\",\"ger\",\"mig\"],\"tbd\",\"Bundestag / Bundesrat\",\"https://www.bundestag.de\"],\n  [\"Germany (Landtage)\",null,2000,2018,[\"mig\"],\"tbd\",\"Landtage (regional)\",\"https://polmine.github.io/MigParl/\"],\n  [\"Ghana\",352280,2005,2024,[\"hm\"],\"tbd\",\"Parliament of Ghana\",\"https://parliament.gh\"],\n  [\"Great Britain\",9177947,1988,2022,[\"pm\",\"ps\",\"pe\"],\"tbd\",\"House of Commons\",\"https://www.parliament.uk\"],\n  [\"Greece\",1623192,1989,2022,[\"pm\",\"mp\"],\"tbd\",\"Voulí ton Ellínon\",\"https://www.hellenicparliament.gr\"],\n  [\"Hungary\",2278295,1994,2022,[\"pm\",\"pl\",\"pe\"],\"tbd\",\"Országgyűlés\",\"https://www.parlament.hu\"],\n  [\"Iceland\",95286,2015,2022,[\"pm\"],\"tbd\",\"Alþingi\",\"https://www.althingi.is\"],\n  [\"Ireland\",21517564,1919,2019,[\"pe\",\"mp\",\"irl\"],\"tbd\",\"Dáil Éireann\",\"https://www.oireachtas.ie\"],\n  [\"Italy\",2627514,1948,2022,[\"pm\",\"ita\"],\"tbd\",\"Camera dei deputati / Senato\",\"https://www.camera.it\"],\n  [\"Latvia\",660012,1993,2022,[\"pm\",\"lnk\"],\"tbd\",\"Saeima\",\"https://www.saeima.lv\"],\n  [\"Netherlands\",1752614,1994,2022,[\"pm\",\"ps\",\"dut\"],\"tbd\",\"Tweede Kamer\",\"https://www.tweedekamer.nl\"],\n  [\"New Zealand\",925766,1987,2019,[\"ps\"],\"tbd\",\"House of Representatives\",\"https://www.parliament.nz\"],\n  [\"Norway\",398809,1998,2022,[\"pm\"],\"tbd\",\"Stortinget\",\"https://www.stortinget.no\"],\n  [\"Poland\",14874946,1919,2025,[\"pm\",\"ppc\"],\"tbd\",\"Sejm\",\"https://www.sejm.gov.pl\"],\n  [\"Portugal\",1472804,2009,2022,[\"pm\",\"pe\",\"mp\"],\"tbd\",\"Assembleia da República\",\"https://www.parlamento.pt\"],\n  [\"Serbia\",316069,1997,2022,[\"pm\"],\"tbd\",\"Narodna skupština\",\"https://www.parlament.rs\"],\n  [\"Slovenia\",311354,2000,2022,[\"pm\"],\"tbd\",\"Državni Zbor\",\"https://www.dz-rs.si\"],\n  [\"South Africa\",309716,1999,2024,[\"hm\"],\"tbd\",\"National Assembly\",\"https://www.parliament.gov.za\"],\n  [\"Spain\",638060,1996,2023,[\"pm\",\"ps\",\"pl\"],\"tbd\",\"Congreso de los Diputados\",\"https://www.congreso.es\"],\n  [\"Spain (Basque)\",39148,2015,2022,[\"pm\"],\"tbd\",\"Eusko Legebiltzarra\",\"https://www.legebiltzarra.eus\"],\n  [\"Spain (Catalonia)\",50824,2015,2022,[\"pm\"],\"tbd\",\"Parlament de Catalunya\",\"https://www.parlament.cat\"],\n  [\"Spain (Galicia)\",83078,2015,2022,[\"pm\"],\"tbd\",\"Parlamento de Galicia\",\"https://www.parlamentodegalicia.es\"],\n  [\"Sweden\",450222,1990,2022,[\"pm\",\"ps\"],\"tbd\",\"Riksdag\",\"https://www.riksdagen.se\"],\n  [\"Turkey\",681052,2011,2022,[\"pm\"],\"tbd\",\"Türkiye Büyük Millet Meclisi\",\"https://www.tbmm.gov.tr\"],\n  [\"Ukraine\",429437,2002,2023,[\"pm\"],\"tbd\",\"Verkhovna Rada\",\"https://www.rada.gov.ua\"],\n  [\"United Nations (UNGA)\",null,1994,2018,[\"unga\"],\"tbd\",\"UN General Assembly\",\"https://zenodo.org/records/3831472\"],\n  [\"United States\",14153443,1873,2017,[\"std\"],\"tbd\",\"US Congress\",\"https://data.stanford.edu/congress_text\"]\n];\n\nvar MIN_YEAR = 1867, MAX_YEAR = 2025;\nvar sortKey = 'country';\n\nfunction setSort(k) {\n  sortKey = k;\n  document.querySelectorAll('th').forEach(function(t){ t.classList.remove('active'); });\n  var map = {country:'th-country',docs_desc:'th-docs',docs_asc:'th-docs',start_asc:'th-start',end_desc:'th-end'};\n  if (map[k]) { var el = document.getElementById(map[k]); if(el) el.classList.add('active'); }\n  renderTable();\n}\n\nfunction fmt(n) { return (n == null) ? 'N/A' : n.toLocaleString('en-GB'); }\n\nfunction switchTab(t) {\n  var isTable = (t === 'table');\n  document.getElementById('table-view').style.display = isTable ? 'block' : 'none';\n  document.getElementById('timeline-view').style.display = isTable ? 'none' : 'block';\n  document.querySelectorAll('.tab').forEach(function(el, i){\n    el.classList.toggle('active', (i===0 && isTable) || (i===1 && !isTable));\n  });\n  if (!isTable) renderTimeline();\n}\n\nfunction renderTable() {\n  var q = document.getElementById('searchBox').value.toLowerCase();\n  var key = document.getElementById('sortCol').value || sortKey;\n  var rows = RAW.filter(function(r){ return r[0].toLowerCase().indexOf(q) > -1 || r[6].toLowerCase().indexOf(q) > -1; });\n  rows.sort(function(a,b){\n    if (key==='country')   return a[0].localeCompare(b[0]);\n    if (key==='docs_desc') return (b[1]||0)-(a[1]||0);\n    if (key==='docs_asc')  return (a[1]||0)-(b[1]||0);\n    if (key==='start_asc') return a[2]-b[2];\n    if (key==='end_desc')  return b[3]-a[3];\n    return 0;\n  });\n\n  var tbody = document.getElementById('tbody');\n  if (!rows.length) {\n    tbody.innerHTML = '<tr><td colspan=\"8\" class=\"no-results\">No countries match your search.<\/td><\/tr>';\n  } else {\n    var span = MAX_YEAR - MIN_YEAR;\n    tbody.innerHTML = rows.map(function(r){\n      var country=r[0],docs=r[1],start=r[2],end=r[3],sources=r[4],note=r[5],parl=r[6],parlUrl=r[7];\n      var lp = Math.round(((start - MIN_YEAR) / span) * 100);\n      var wp = Math.max(1, Math.round(((end - start) / span) * 100));\n      var badges = sources.map(badge).join('');\n      return '<tr>'\n        +'<td>'+country+'<\/td>'\n        +'<td><a href=\"'+parlUrl+'\" class=\"parl-link\" target=\"_blank\" rel=\"noopener\">'+parl+'<\/a><\/td>'\n        +'<td class=\"docs\">'+fmt(docs)+'<\/td>'\n        +'<td>'+start+'<\/td>'\n        +'<td>'+end+'<\/td>'\n        +'<td class=\"bar-cell\"><div class=\"bar-bg\"><div class=\"bar-fill\" style=\"left:'+lp+'%;width:'+wp+'%\"><\/div><\/div><div class=\"year-label\">'+start+'–'+end+'<\/div><\/td>'\n        +'<td class=\"sources-cell\">'+badges+'<\/td>'\n        +'<td class=\"note\">'+note+'<\/td>'\n        +'<\/tr>';\n    }).join('');\n  }\n\n  var totalDocs = rows.reduce(function(s,r){ return s+(r[1]||0); }, 0);\n  var minStart = Math.min.apply(null, rows.map(function(r){ return r[2]; }));\n  var maxEnd   = Math.max.apply(null, rows.map(function(r){ return r[3]; }));\n  var avgSpan  = rows.length ? Math.round(rows.reduce(function(s,r){ return s+(r[3]-r[2]); },0)/rows.length) : 0;\n  document.getElementById('summaryRow').innerHTML =\n    '<div class=\"metric\"><div class=\"metric-label\">Parliamentary data available for<\/div><div class=\"metric-value\">'+rows.length+' countries<\/div><\/div>'\n   +'<div class=\"metric\"><div class=\"metric-label\">Speeches<\/div><div class=\"metric-value\">'+fmt(totalDocs)+'<\/div><\/div>'\n   +'<div class=\"metric\"><div class=\"metric-label\">Avg. coverage span<\/div><div class=\"metric-value\">'+avgSpan+' yrs<\/div><\/div>'\n   +'<div class=\"metric\"><div class=\"metric-label\">Total time span (all data)<\/div><div class=\"metric-value\">'+minStart+'–'+maxEnd+'<\/div><\/div>';\n  document.getElementById('footerLine').textContent = 'Showing '+rows.length+' of '+RAW.length+' countries · '+fmt(totalDocs)+' speeches';\n}\n\nfunction renderTimeline() {\n  var container = document.getElementById('tlContainer');\n  var span = MAX_YEAR - MIN_YEAR;\n  var axisYears = [1870,1880,1890,1900,1910,1920,1930,1940,1950,1960,1970,1980,1990,2000,2010,2020,2025];\n\n  var html = '<div class=\"tl-axis-row\"><div class=\"tl-axis-spacer\"><\/div><div class=\"tl-axis-track\">';\n  axisYears.forEach(function(y){\n    var pct = ((y - MIN_YEAR) / span * 100).toFixed(2);\n    html += '<span class=\"tl-axis-label\" style=\"left:'+pct+'%\">'+y+'<\/span>';\n  });\n  html += '<\/div><\/div>';\n\n  RAW.forEach(function(r, i){\n    var start=r[2], end=r[3];\n    var lp = ((start - MIN_YEAR) / span * 100).toFixed(2);\n    var wp = Math.max(0.5, ((end - start) / span * 100)).toFixed(2);\n    html += '<div class=\"tl-row-wrap\" id=\"tlrow-'+i+'\">'\n      +'<div class=\"tl-label\">'+r[0]+'<\/div>'\n      +'<div class=\"tl-track\" onmouseenter=\"tlHover('+i+',event)\" onmouseleave=\"tlUnhover()\">'\n      +'<div class=\"tl-bar\" style=\"left:'+lp+'%;width:'+wp+'%\"><\/div>'\n      +'<\/div>'\n      +'<\/div>';\n  });\n\n  container.innerHTML = html;\n}\n\nfunction tlHover(idx, e) {\n  for (var i=0; i<RAW.length; i++) {\n    var el = document.getElementById('tlrow-'+i);\n    if (el) {\n      if (i !== idx) el.classList.add('dimmed');\n      else el.classList.remove('dimmed');\n    }\n  }\n  var r = RAW[idx];\n  document.getElementById('tt-name').textContent = r[0];\n  document.getElementById('tt-period').textContent = r[2]+'–'+r[3];\n  document.getElementById('tt-docs').textContent = fmt(r[1]);\n  document.getElementById('tt-sources').innerHTML = r[4].map(badge).join('');\n  var tt = document.getElementById('tl-tooltip');\n  tt.style.display = 'block';\n  posTooltip(e);\n}\n\nfunction posTooltip(e) {\n  var tt = document.getElementById('tl-tooltip');\n  tt.style.left = (e.clientX + 14) + 'px';\n  tt.style.top  = (e.clientY - 10) + 'px';\n}\n\nfunction tlUnhover() {\n  for (var i=0; i<RAW.length; i++) {\n    var el = document.getElementById('tlrow-'+i);\n    if (el) el.classList.remove('dimmed');\n  }\n  document.getElementById('tl-tooltip').style.display = 'none';\n}\n\ndocument.addEventListener('mousemove', function(e){\n  var tt = document.getElementById('tl-tooltip');\n  if (tt.style.display === 'block') posTooltip(e);\n});\n\nrenderTable();\n<\/script>\n<\/body>\n<\/html>\n","type":"text"}]
